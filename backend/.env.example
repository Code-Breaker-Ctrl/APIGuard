# ========================================================
# APIGuard - LLM Remediation Configuration
# Provider Priority: OpenRouter -> Gemini -> Offline Template
# ========================================================

# OpenRouter Provider (Recommended: OpenAI-compatible, supports free models)
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: specify a model (e.g. "recursive/flint-v1.0:free" or "meta-llama/llama-3.2-3b-instruct:free").
# If unset, APIGuard queries OpenRouter for available free models (pricing = "0").
OPENROUTER_MODEL=

# Google Gemini Provider (Fallback if OPENROUTER_API_KEY not configured)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=
# Optional: specify a Gemini model (e.g. "gemini-2.0-flash" or "gemini-1.5-flash").
GEMINI_MODEL=
